# Serveur & Rendu
NODE_ENV=production
PORT=10000

# Authentification JWT
JWT_SECRET=remplacer_par_une_cle_secrete_robuste
JWT_EXPIRES_IN=24h

# Base de données PostgreSQL / Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_supabase
# SUPABASE_ANON_KEY=optionnel_si_service_role_fournie

# Origines autorisées pour le Frontend Vercel (séparées par des virgules si plusieurs)
ALLOWED_ORIGINS=https://votre-frontend-pken.vercel.app
